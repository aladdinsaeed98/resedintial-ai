{
  "name": "residential-hvac-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Monitor-only residential HVAC hub. Reads MQTT, stores SQLite, serves a live page. No write path to equipment.",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server.ts --dev",
    "build": "next build",
    "hub": "cross-env NODE_ENV=production tsx server.ts",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "simulate": "tsx simulator/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "mqtt": "^5.10.4",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
