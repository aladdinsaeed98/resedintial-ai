{
  "name": "residential-hvac-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Monitor-only residential HVAC dashboard. Next.js on Vercel, Prisma/Postgres, Clerk, local MQTT collector. No write path to equipment.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start -p 3000",
    "collector": "tsx server.ts",
    "hub": "tsx server.ts",
    "simulate": "tsx simulator/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.7",
    "@prisma/client": "^6.19.3",
    "better-sqlite3": "^11.10.0",
    "mqtt": "^5.10.4",
    "next": "^15.5.4",
    "prisma": "^6.19.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
