# Copy this file to .env.local for localhost:3000:
#   Windows PowerShell:  Copy-Item .env.example .env.local
# Then paste real values. .env.local is gitignored. Never put real keys here.
#
# Production values go in the Vercel project Environment Variables UI
# (and Clerk). The committed .env.production file is empty on purpose.

# --- Clerk (https://dashboard.clerk.com → your app → API keys) ---
# Publishable key is safe to expose in the browser. Secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_paste_from_clerk_dashboard
CLERK_SECRET_KEY=sk_test_paste_from_clerk_dashboard
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# --- Postgres (Vercel Marketplace Postgres / Neon, or local Docker) ---
# Vercel → Project → Storage → Postgres (Neon) → .env.local snippet.
# Pooled URL for the app. Direct URL for `prisma migrate` (Neon requires both).
# Local Docker (docker compose up -d postgres):
#   DATABASE_URL=postgresql://hvac:hvac@127.0.0.1:5432/hvac
#   DIRECT_URL=postgresql://hvac:hvac@127.0.0.1:5432/hvac
DATABASE_URL=postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder
DIRECT_URL=postgresql://placeholder:placeholder@127.0.0.1:5432/placeholder

# --- Collector → Vercel ingest ---
# Long random string. Same value in .env.local (collector) and in Vercel env.
# Generate one:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }) -as [byte[]])
INGEST_SECRET=generate_a_long_random_string

# GET /api/cron/rules. Same value in Vercel env AND the home collector.
# Vercel Hobby cron is a once-a-day backstop; the collector ticks this every 60 s.
CRON_SECRET=generate_a_long_random_string

# URL the Windows/Pi collector POSTs to. Local Next.js:
HUB_INGEST_URL=http://localhost:3000/api/ingest
# Production collector (same secret, this URL instead):
# HUB_INGEST_URL=https://YOUR_VERCEL_APP.vercel.app/api/ingest

# --- Local collector / Mosquitto (Windows PC or Pi next to the broker) ---
# Do not port-forward 1883. These are unused on Vercel.
HVAC_MQTT_HOST=127.0.0.1
HVAC_MQTT_PORT=1883
# SQLite retry buffer for the collector (not the cloud database).
# Default on Windows: %LOCALAPPDATA%\hvac-monitor\hvac.db
# HVAC_DB=C:\Users\YOU\AppData\Local\hvac-monitor\hvac.db
HVAC_SYSTEM_NAME=Bench
HVAC_STALE_AFTER_SECONDS=120
# HVAC_POINTS_FILE=config/points.json
# HVAC_HOST and HVAC_PORT are unused by `next dev` (always :3000).
HVAC_HOST=127.0.0.1
HVAC_PORT=3000

# --- Demo mode (local UI review only) ---
# Set to 1 in .env.local to serve fake readings/alerts without MQTT, collector, or DB.
# Off by default. Blocked when NODE_ENV or VERCEL_ENV is production.
# HVAC_DEMO=1
HVAC_DEMO=
